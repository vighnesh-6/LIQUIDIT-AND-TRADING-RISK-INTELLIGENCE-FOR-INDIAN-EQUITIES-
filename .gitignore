# Project Data Directories & Artifacts
# Datasets across data/raw/, data/interim/, data/processed/, data/predictions/,
# data/manifests/, and data/events/ are eligible for tracking in Git.

# Manifests and Events: ignore temporary dumps but allow all datasets
data/events/*.tmp

# Model Artifacts (Binary weights / scalers)
models/*.joblib
models/*.pkl
models/*.onnx
!models/model_registry.json

# Runtime Logs
logs/*.log
!logs/.gitkeep

# Temporary & Atomic Write Files
*.tmp
*.tmp.parquet

# Reports Output (allow report figures and markdown to be tracked)
# !reports/figures/*.png

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
